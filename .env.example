# ─────────────────────────────────────────────────────────────
# CareSense environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ─────────────────────────────────────────────────────────────

# ── Backend mode ─────────────────────────────────────────────
# If SUPABASE_URL and SUPABASE_ANON_KEY are both set, CareSense uses
# Supabase (Postgres + Auth + Storage, row-level security enforced).
# If they are NOT set, CareSense runs in local DEMO MODE: a JSON file
# store in ./.data seeded with the fictional patient "Lakshmi Raman".
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Storage bucket for original medical documents (private bucket).
SUPABASE_RECORDS_BUCKET=medical-records

# ── Demo mode ────────────────────────────────────────────────
# Demo mode is refused when NODE_ENV=production unless this is "true".
# Only enable it for a public demo containing fictional data.
DEMO_MODE_ALLOWED_IN_PRODUCTION=false
# Secret used to sign demo-mode session cookies (32+ random chars).
SESSION_SECRET=change-me-to-a-long-random-string

# ── AI (server-side only) ────────────────────────────────────
# Without a key the app still works: the safety engine, medication
# guard and factual lookups run deterministically; AI summaries and
# free-form answers show a friendly "not available right now" message.
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5
CARESENSE_AI_MODEL=
